import { Const } from "consts.slint";
import {
    MyVerticalLayout,
    NormalText,
    H2Text,
    RegularButton,
    H3Text,
    H1Text,
    MyHorizontalLayout,
} from "elements.slint";
import { Logic } from "logic.slint";
import { Palette } from "palette.slint";
import { KeyboardLogic } from "keyboard.slint";

export global ProgressWindowLogic {
    pure callback action_button_pressed();
    pure callback cancel_button_pressed();
    pure callback ok_button_pressed();
    pure callback next_button_pressed();
    pure callback toggle_light();

    in-out property <string> title;  // the title of the workflow
    in-out property <string> description;  // general, short description of the workflow
    in-out property <string> message;  // a small message to the user
    in-out property <string> timer;  // a timer, if it exists
    in-out property <bool> error_mode;  // If true, message is displayed in red.
    in-out property <bool> show_vacuum_plot;

    // Define some default buttons and an action button that is user adjustable. 
    in-out property <bool> cancel_button_enabled;
    in-out property <bool> ok_button_enabled;
    in-out property <bool> next_button_enabled;
}

export component ProgressWindow inherits Window {

    full-screen: true;
    always-on-top: true;

    background: Palette.bg;
    no-frame: true;

    MyVerticalLayout {

        H1Text {
            text: ProgressWindowLogic.title;
            horizontal-alignment: center;
        }

        MyHorizontalLayout {
            alignment: center;
            H3Text {
                text: ProgressWindowLogic.description;
                font-italic: true;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if ProgressWindowLogic.message != "": MyHorizontalLayout {
            alignment: center;
            H2Text {
                text: ProgressWindowLogic.message;
                wrap: word-wrap;
                horizontal-alignment: center;
                color: ProgressWindowLogic.error_mode ? Palette.red : Palette.text;
            }
        }

        if ProgressWindowLogic.timer != "": H3Text {
            text: "Remaining time:\n" + ProgressWindowLogic.timer;
            horizontal-alignment: center;
        }

        if ProgressWindowLogic.show_vacuum_plot: Image {
            source: Logic.vacuum_plot;
        }

        MyHorizontalLayout {
            alignment: center;
            padding-bottom: Const.border_spacing;

            if ProgressWindowLogic.cancel_button_enabled: RegularButton {
                enabled: true;
                text: "Cancel";
                clicked => {
                    ProgressWindowLogic.cancel_button_pressed();
                }
            }

            RegularButton {
                enabled: true;
                text: "Toggle Light";
                clicked => {
                    ProgressWindowLogic.toggle_light()
                }
            }

            if ProgressWindowLogic.next_button_enabled: RegularButton {
                enabled: true;
                text: "Next";
                clicked => {
                    ProgressWindowLogic.next_button_pressed();
                }
            }

            if ProgressWindowLogic.ok_button_enabled: RegularButton {
                enabled: true;
                text: "Ok";
                clicked => {
                    ProgressWindowLogic.ok_button_pressed();
                }
            }
        }
    }
}
